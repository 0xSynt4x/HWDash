{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HWDash",
  "version": "0.4.3",
  "identifier": "com.dylan.hwdash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hwdash-sidecar"
    ],
    "resources": {
      "binaries/BlackSharp.Core.dll": "BlackSharp.Core.dll",
      "binaries/DiskInfoToolkit.dll": "DiskInfoToolkit.dll",
      "binaries/HidSharp.dll": "HidSharp.dll",
      "binaries/LibreHardwareMonitorLib.dll": "LibreHardwareMonitorLib.dll",
      "binaries/Mono.Posix.NETStandard.dll": "Mono.Posix.NETStandard.dll",
      "binaries/MonoPosixHelper.dll": "MonoPosixHelper.dll",
      "binaries/RAMSPDToolkit-NDD.dll": "RAMSPDToolkit-NDD.dll",
      "binaries/System.CodeDom.dll": "System.CodeDom.dll",
      "binaries/System.IO.Ports.dll": "System.IO.Ports.dll",
      "binaries/System.Management.dll": "System.Management.dll",
      "binaries/System.Threading.AccessControl.dll": "System.Threading.AccessControl.dll",
      "binaries/libMonoPosixHelper.dll": "libMonoPosixHelper.dll",
      "binaries/hwdash-sidecar.deps.json": "hwdash-sidecar.deps.json",
      "binaries/hwdash-sidecar.dll": "hwdash-sidecar.dll",
      "binaries/hwdash-sidecar.runtimeconfig.json": "hwdash-sidecar.runtimeconfig.json"
    }
  }
}
